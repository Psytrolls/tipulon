# ==============================================================================
# Tipulon Environment Configuration (.env)
# ==============================================================================

NODE_ENV=production
PORT=3000
TZ=Asia/Jerusalem

# Session signing secret (minimum 32 random characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Backup AES-256-GCM encryption key (MUST be at least 32 characters / 32 bytes)
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=

# Optional SMTP configuration for email delivery of encrypted backups
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BACKUP_EMAIL=
